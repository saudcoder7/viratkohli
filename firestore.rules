rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Format Stats (Live & Final from Cloud Function / Seed) ───
    // Read-only from the client. Writable only by Cloud Function / Admin SDK.
    match /stats/{format} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Legacy Cached Stats (from Cloud Function) ───
    match /config/cachedStats {
      allow read: if true;
      allow write: if false; // Admin SDK bypasses rules
    }

    // ─── Fan Wall Messages ───
    match /fanWall/{messageId} {
      // Anyone can read messages
      allow read: if true;

      // Authenticated users can create messages
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['text', 'timestamp', 'uid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;

      // Users cannot edit or delete messages (even their own)
      allow update, delete: if false;
    }

    // ─── Poll Votes ───
    // Each user gets one vote document keyed by their UID
    match /pollVotes/{voteId} {
      // Anyone can read votes (for real-time results)
      allow read: if true;

      // Authenticated users can create their own vote (one per UID)
      allow create: if request.auth != null
        && voteId == request.auth.uid
        && request.resource.data.keys().hasAll(['option', 'timestamp'])
        && request.resource.data.option is string
        && request.resource.data.option.size() > 0;

      // Users cannot change their vote once cast
      allow update, delete: if false;
    }

    // ─── Deny everything else ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
